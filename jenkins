pipeline {

    agent any

    tools {
        jdk 'JAVA'
        maven 'MAVEN'
    }

    environment {
        APP_MODULE = 'kafka'

        DOCKER_IMAGE = 'aglseshasaikumarreddy/camel-kafka'
        DOCKER_TAG = "${BUILD_NUMBER}"

        DOCKER_CREDENTIALS = 'dockerhub-credentials'
        SSH_CREDENTIALS = 'deployment-ssh'

        DEPLOY_USER = 'ec2-user'
        DEPLOY_HOST = '10.10.1.87'

        CONTAINER_NAME = 'camel-kafka'

        APP_PORT = '8081'
    }

    stages {

        stage('Checkout') {
            steps {
                git(
                    url: 'https://github.com/saikumar-aglgrouptech/Agl_Project_1.git',
                    branch: 'main'
                )
            }
        }

        stage('Compile') {
            steps {
                sh '''
                    mvn -pl ${APP_MODULE} -am clean compile -DskipTests
                '''
            }
        }

        stage('Unit Test') {
            steps {
                sh '''
                    mvn -pl ${APP_MODULE} -am test
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                        mvn -pl ${APP_MODULE} -am verify \
                            -DskipTests \
                            org.sonarsource.scanner.maven:sonar-maven-plugin:5.8.0.7211:sonar
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Package') {
            steps {
                sh '''
                    mvn -pl ${APP_MODULE} -am package -DskipTests

                    echo "===== JAR FILES ====="

                    find ${APP_MODULE}/target \
                        -maxdepth 1 \
                        -type f \
                        -name "*.jar" \
                        -print
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    cd ${APP_MODULE}

                    docker build \
                        -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                        -t ${DOCKER_IMAGE}:latest \
                        .
                '''
            }
        }

        stage('Docker Login') {
    steps {
        withCredentials([
            usernamePassword(
                credentialsId: "${DOCKER_CREDENTIALS}",
                usernameVariable: 'DOCKER_USERNAME',
                passwordVariable: 'DOCKER_PASSWORD'
            )
        ]) {
            sh '''
                echo "$DOCKER_PASSWORD" | \
                docker login \
                -u "$DOCKER_USERNAME" \
                --password-stdin
            '''
        }
    }
}
        stage('Docker Push') {
            steps {
                sh '''
                    docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                    docker push ${DOCKER_IMAGE}:latest
                '''
            }
        }

       stage('Deploy to EC2') {
    steps {
        withCredentials([
            usernamePassword(
                credentialsId: "${DOCKER_CREDENTIALS}",
                usernameVariable: 'DOCKER_USERNAME',
                passwordVariable: 'DOCKER_PASSWORD'
            )
        ]) {
            sshagent(["${SSH_CREDENTIALS}"]) {

                sh '''
                    ssh -o StrictHostKeyChecking=no \
                    ${DEPLOY_USER}@${DEPLOY_HOST} \
                    "echo '${DOCKER_PASSWORD}' | docker login \
                    -u '${DOCKER_USERNAME}' --password-stdin"
                '''

                sh '''
                    ssh -o StrictHostKeyChecking=no \
                    ${DEPLOY_USER}@${DEPLOY_HOST} \
                    "docker pull ${DOCKER_IMAGE}:${DOCKER_TAG}"
                '''

                sh '''
                    ssh -o StrictHostKeyChecking=no \
                    ${DEPLOY_USER}@${DEPLOY_HOST} \
                    "docker stop ${CONTAINER_NAME} || true"
                '''

                sh '''
                    ssh -o StrictHostKeyChecking=no \
                    ${DEPLOY_USER}@${DEPLOY_HOST} \
                    "docker rm ${CONTAINER_NAME} || true"
                '''

                sh '''
                    ssh -o StrictHostKeyChecking=no \
                    ${DEPLOY_USER}@${DEPLOY_HOST} \
                    "docker run -d \
                    --name ${CONTAINER_NAME} \
                    --restart unless-stopped \
                    -p ${APP_PORT}:8081 \
                    ${DOCKER_IMAGE}:${DOCKER_TAG}"
                '''

                sh '''
                    ssh -o StrictHostKeyChecking=no \
                    ${DEPLOY_USER}@${DEPLOY_HOST} \
                    "docker ps"
                '''
            }
        }
    }
}

        stage('Verify Deployment') {
            steps {
                sshagent(["${SSH_CREDENTIALS}"]) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no \
                        ${DEPLOY_USER}@${DEPLOY_HOST} \
                        "docker ps --filter name=${CONTAINER_NAME}"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "CI/CD pipeline completed successfully."
        }

        failure {
            echo "CI/CD pipeline failed."
        }

        always {
            cleanWs()
        }
    }
}
